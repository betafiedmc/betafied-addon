{ "namespace": "bfui-chat_screen",
  "root_panel": {
    "type": "panel",
    "controls": [
      { "main_element@bfui-chat_screen.main_element": {}},
      { "close_button_element@crafting.close_button_element": {}}
    ]
  },
  "main_element": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100% - 4px", "100%" ],
    "controls": [
      { "nevergonnagiveyouup": {
          "type": "panel",
          "size": [ 1, "fill" ]
      }},
      { "message_box@bfui-chat_screen.message_box": {}},
      { "padding_between_message_and_textbox": {
          "type": "panel",
          "size": [ 1, 29 ]
      }},
      { "nevergonnaletyoudown": {
          "type": "image",
          "texture": "textures/ui/Black",
          "size": [ "100%", 12 ],
          "alpha": 0.7,
          "controls": [
            { "stack_panel": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "size": [ "100%", 12 ],
                "offset": [ 0, 1 ],
                "controls": [
                  { "padding_bottom": {
                      "type": "panel",
                      "size": [ 2, 2 ]
                  }},
                  { "text": {
                      "type": "label",
                      "text": "> ",
                      "shadow": true
                  }},
                  { "chat_textbox@bfui-chat_screen.chat_textbox": {}},
                  { "chat_send_btn_panel": {
                      "type": "panel",
                      "size": [ 50, 12 ],
                      "controls": [
                        { "chat_send_btn@common_buttons.light_text_button": {
                            "$pressed_button_name": "button.send",
                            "offset": [ 0, -1 ],
                            "layer": 100,
                            "$focus_id": "send_button_focus_id",
                            "$focus_override_up": "paste_button_focus_id",
                            "controls": [
                              { "panel@bfui-chat_screen.send_element": {}}
                            ],
                            "bindings": [
                              { "binding_name": "#send_button_visible",
                                "binding_name_override": "#enabled"
                            }]
                        }}]
                  }}]
            }}]
      }},
      { "padding_bottom": {
          "type": "panel",
          "size": [ 1, 1 ]
      }}
  ]},
  "chat_textbox@common.text_edit_box": {
    "size": [ "fill", 12 ],
    "$text_edit_box_label_anchor_point": "top_left",
    "$text_edit_box_label_anchor_point|default": "top_left",
    "$text_box_name": "#message_text_box",
    "$text_edit_box_content_binding_name": "#message_text_box_content",
    "always_listening": true,
    "max_length": 20000,
    "$text_background_locked|default": "$text_background_default",
    "$text_background_locked": "$text_background_default",
    "$text_clear_button_enabled|default": false,
    "button_mappings": [
      // Original Mappings - defined in common.text_edit_box //
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": false,
        "handle_deselect": true,
        "mapping_type": "global",
        // Deselect textbox and allow selection of another UI control with same mouse press
        "consume_event": false
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": true,
        "handle_deselect": true,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": false,
        "handle_deselect": true,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "$text_edit_box_deselected_to_button_id",
        "handle_select": false,
        "handle_deselect": true,
        "mapping_type": "global"
      },
      {
        "to_button_id": "$text_edit_box_hovered_button_id",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "$text_edit_box_clear_from_button_id",
        "to_button_id": "$text_edit_box_clear_to_button_id",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },

      // Extra Mappings //
      {
        "from_button_id": "button.menu_autocomplete",
        "to_button_id": "button.chat_autocomplete",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_autocomplete_back",
        "to_button_id": "button.chat_autocomplete_back",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_textedit_up",
        "to_button_id": "button.chat_previous_message",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.menu_textedit_down",
        "to_button_id": "button.chat_next_message",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "focused"
      },

      // Controller Mappings //
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.send",
        "mapping_type": "global",
        "handle_select": false,
        "handle_deselect": false
      },
      {
        "from_button_id": "button.controller_start",
        "to_button_id": "button.send",
        "mapping_type": "global",
        "handle_select": false,
        "handle_deselect": false
      },
      {
        "from_button_id": "button.controller_autocomplete",
        "to_button_id": "button.chat_autocomplete",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.controller_autocomplete_back",
        "to_button_id": "button.chat_autocomplete_back",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.controller_textedit_up",
        "to_button_id": "button.chat_previous_message",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.controller_textedit_down",
        "to_button_id": "button.chat_next_message",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.chat_paste_coordinates",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "global"
      }
    ],
    "controls": [
      { "text_field_panel@bfui-chat_screen.text_field_panel": {}}
  ]},
  "text_field_panel": {
    "type": "panel",
    "controls": [
      { "clipper_panel": {
          "type": "panel",
          "size": "$text_edit_clipping_panel_size",
          "offset": "$text_offset",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "clips_children": true,
          "$disabled_color": "$color",
          "controls": [
            { "$text_edit_text_control@bfui-chat_screen.text_field_label": {
                "layer": 4,
                "shadow": true,
                "offset": [ 0, 0.5 ]
          }}]
      }}
  ]},
  "text_field_image": {
    "type": "image",
    "texture": "textures/ui/Black"
  },
  "text_field_label": {
    "type": "label",
    "layer": 4,
    "$text_box_font_scale_factor|default": 1.0,
    "font_scale_factor": "$text_box_font_scale_factor",
    "$text_box_line_padding|default": -1.0,
    "line_padding": "$text_box_line_padding",
    "size": "$text_edit_box_label_size",
    "offset": "$text_edit_box_label_offset",
    "min_size": "$text_edit_box_label_min_size",
    "anchor_from": "$text_edit_box_label_anchor_point",
    "anchor_to": "$text_edit_box_label_anchor_point",
    "localize": false,
    "enable_profanity_filter": "$enable_profanity_filter",
    "shadow": true,
    "color": "$text_box_text_color",
    "locked_color": "$locked_color",
    "alpha": "$text_alpha",
    "locked_alpha": "$locked_text_alpha",
    "font_size": "$font_size",
    "text_alignment": "$text_alignment",
    "$enable_profanity_filter|default": false,
    "$text_alpha|default": 1.0,
    "$locked_color|default": [ 1.0, 1.0, 1.0, 1.0 ],
    "$locked_text_alpha|default": 0.5,
    "$font_size|default": "normal",
    "$text_alignment|default": "left",
    "$text_edit_box_content_binding_type|default": "global",
    "$text_edit_box_content_binding_name|default": "#text_box_item_name",
    "$text_edit_box_binding_condition|default": "visible",
    "$text_box_name|default": "#text_box_name",
    "$text_color_binding_name|default": "#edit_box_text_color",
    "$text_color_binding_type|default": "none",
    "text": "#item_name",
    "$text_edit_box_binding_type": "global",
    "$text_edit_box_binding_collection_name": "",
    "$text_box_tts_name|default": "",
    "tts_name": "$text_box_tts_name",
    "property_bag": {
      "#property_field": "#item_name"
    },
    "bindings": [
      { "binding_type": "$text_edit_box_content_binding_type",
        "binding_condition": "$text_edit_box_binding_condition",
        "binding_collection_name": "$text_edit_box_grid_collection_name",
        "binding_name": "$text_edit_box_content_binding_name",
        "binding_name_override": "#item_name"
      },
      { "binding_type": "$text_color_binding_type",
        "binding_name": "$text_color_binding_name",
        "binding_name_override": "#color"
      },
      { "binding_name": "#newline_refresh" }
  ]},
  "send_element": {
    "type": "image",
    "texture": "textures/ui/Black",
    "alpha": 0.7,
    "size": [ 50, 12 ],
    "controls": [
      { "label": {
          "type": "label",
          "text": "Send",
          "shadow": true
      }}
  ]},
  "message_box": {
    "type": "panel",
    "bindings": [
      { "binding_name": "#chat_visible",
        "binding_name_override": "#visible"
    }],
    "size": [ 324, 180 ],
    "controls": [
      { "scrolling_panel@bfui-chat_screen.scrolling_panel": {
          "$jump_to_bottom_on_update": true,
          "$always_handle_scrolling": true,
          "$scrolling_content": "bfui-chat_screen.messages_stack_panel"
      }}
  ]},
  "messages_stack_panel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "$scrolling_content_anchor_from": "bottom_left",
    "$scrolling_content_anchor_to": "bottom_left",
    "factory": {
      "name": "messages_factory",
      "control_ids": {
        "chat_screen_messages": "bfui-chat_screen.chat_grid_item"
  }}},
  "chat_grid_item": {
    "type": "image",
    "size": [ 312, "100%c" ],
    "texture": "textures/ui/Black",
    "layer": 5,
    "clips_children": false,
    "alpha": 0.5,
    "controls": [
      { "text_wrapper": {
          "type": "panel",
          "size": [ 312, "100%c" ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "controls": [
            { "text": {
                "type": "label",
                "text": "#text",
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "shadow": true,
                "localize": false,
                "size": [ 312, "default" ],
                "offset": [ 0, -0.7 ],
                "enable_profanity_filter": true,
                "bindings": [
                  { "binding_name": "#text",
                    "binding_type": "collection",
                    "binding_collection_name": "chat_text_grid"
                  },
                  { "binding_type": "view",
                    "source_property_name": "#text",
                    "target_property_name": "#chat_text"
                  }
              ]}
          }]
      }}
  ]},
  "scrolling_panel": {
    "type": "panel",
    "$scrolling_pane_size|default": [ "100%", "100%" ],
    "$scrolling_pane_offset|default": [ 0, 0 ],
    "$scroll_view_control_size|default": [ "100%", "100%" ],
    "$background_size|default": [ "100%", "100%" ],
    "$background_offset|default": [ 0, 0 ],
    "$scroll_view_port_size|default": [ "100%", "100%" ],
    "$scroll_view_port_max_size|default": [ "100%", "100%" ],
    "$scroll_view_port_offset|default": [ 0, 0 ],
    "$scroll_bar_left_padding_size|default": [ 0, 0 ],
    "$scroll_bar_right_padding_size|default": [ 0, 0 ],
    "$view_port_size|default": [ "fill", "100%" ],
    "$scroll_bar_contained|default": true,
    "$scroll_size|default": [ 0, "100%" ],
    "$scroll_box_size|default": [ "100%", "100%" ],
    "$allow_scrolling_even_when_content_fits|default": true,
    "$scroll_box_visible|default": false,
    "$use_touch_mode|default": false,
    "$show_background|default": false,
    "controls": [
      { "scroll_mouse@common.scrolling_panel_base": {
          "size": "$scrolling_pane_size",
          "offset": "$scrolling_pane_offset"
      }}
  ]}
}